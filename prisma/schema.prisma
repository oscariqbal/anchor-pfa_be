// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../docs/ERD.svg"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WalletType {
  CASH
  BANK
  E_MONEY
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model User {
  id        Int     @id @default(autoincrement())
  name      String
  email     String  @unique
  password  String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  wallets    Wallet[]
}

model Wallet {
  id          Int        @id @default(autoincrement())
  type        WalletType
  name        String
  description String?
  isArchived    Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId Int

  user                 User          @relation(fields: [userId], references: [id])
  outgoingTransactions Transaction[] @relation("TransactionSourceWallet")
  incomingTransactions Transaction[] @relation("TransactionDestinationWallet")
}

model Transaction {
  id          Int             @id @default(autoincrement())
  type        TransactionType
  amount      Decimal         @db.Decimal(15, 2)
  note        String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sourceWalletId         Int?
  destinationWalletId    Int?

  sourceWallet         Wallet?               @relation("TransactionSourceWallet", fields: [sourceWalletId], references: [id])
  destinationWallet    Wallet?               @relation("TransactionDestinationWallet", fields: [destinationWalletId], references: [id])
}

